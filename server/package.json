{
    "name": "server",
    "version": "1.0.0",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "agent": "tsx src/agent/agent.ts",
        "prebuild": "pnpm --filter genblaze build",
        "build": "node -e \"require('fs-extra').removeSync('dist')\" && npx esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm \"--banner:js=import { createRequire as __esbuild_createRequire } from 'module'; import { fileURLToPath as __esbuild_fileURLToPath } from 'url'; import { dirname as __esbuild_dirname } from 'path'; const require = __esbuild_createRequire(import.meta.url); const __filename = __esbuild_fileURLToPath(import.meta.url); const __dirname = __esbuild_dirname(__filename);\" --outfile=dist/index.js --alias:canvas=@napi-rs/canvas --external:@napi-rs/canvas --external:@napi-rs/canvas-* --external:playwright --external:playwright-core --external:chromium-bidi* --external:@ffmpeg-installer/* --external:@ffprobe-installer/* --external:fsevents && node -e \"require('fs-extra').copySync('src/prompts', 'dist/prompts')\"",
        "start": "node dist/index.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.966.0",
        "@aws-sdk/s3-request-presigner": "^3.966.0",
        "@backblaze-labs/b2-sdk": "^0.2.0",
        "@ffmpeg-installer/ffmpeg": "^1.1.0",
        "@ffprobe-installer/ffprobe": "^2.1.2",
        "@google-cloud/text-to-speech": "^6.4.0",
        "@google/adk": "^1.1.0",
        "@google/genai": "^1.40.0",
        "@googleapis/drive": "^20.2.0",
        "@napi-rs/canvas": "^1.0.3",
        "@playzone/youtube-transcript": "^1.0.0",
        "archiver": "^7.0.1",
        "axios": "^1.13.2",
        "bcryptjs": "^3.0.3",
        "cheerio": "^1.1.2",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.0",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^8.2.1",
        "firebase-admin": "^13.6.0",
        "fluent-ffmpeg": "^2.1.3",
        "formdata-node": "^6.0.3",
        "genblaze": "file:../genblaze",
        "google-auth-library": "^10.5.0",
        "helmet": "^8.1.0",
        "ioredis": "^5.9.2",
        "jsonwebtoken": "^9.0.3",
        "mammoth": "^1.11.0",
        "mongoose": "^9.1.2",
        "multer": "^2.0.2",
        "nanoid": "^5.1.6",
        "node-fetch": "^2.7.0",
        "node-media-server": "^4.2.4",
        "node-os-utils": "^2.0.1",
        "nodemailer": "^7.0.12",
        "pdf-img-convert": "^2.0.0",
        "pdf-parse": "^2.4.5",
        "playwright": "^1.58.0",
        "pptxtojson": "^1.12.0",
        "socket.io": "^4.8.3",
        "stripe": "^20.1.2",
        "systeminformation": "^5.30.6",
        "uuid": "^13.0.0",
        "ws": "^8.19.0",
        "youtube-dl-exec": "^3.0.30"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/express-mongo-sanitize": "^2.1.2",
        "@types/express-rate-limit": "^6.0.2",
        "@types/geoip-lite": "^1.4.4",
        "@types/helmet": "^4.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^20.0.0",
        "@types/node-fetch": "^2.6.13",
        "@types/nodemailer": "^7.0.4",
        "@types/uuid": "^11.0.0",
        "@types/ws": "^8.18.1",
        "@types/node-media-server": "^2.3.7",
        "@vercel/ncc": "^0.38.4",
        "esbuild": "^0.24.2",
        "fs-extra": "^11.3.3",
        "javascript-obfuscator": "^5.3.0",
        "nodemon": "^3.1.9",
        "pkg": "^5.8.1",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.21.0",
        "typescript": "^5.7.0"
    }
}
